# AWS RDS PostgreSQL connection string.
# Prisma v7 uses the `pg` driver; SSL is configured in code via backend/certs/global-bundle.pem.
DATABASE_URL="postgresql://alterstayuser:<DB_PASSWORD>@alterstaydb.cqx8agsuaku7.us-east-1.rds.amazonaws.com:5432/postgres?schema=public&sslmode=require"
# Optional override for the RDS CA bundle path (defaults to backend/certs/global-bundle.pem)
# DATABASE_SSL_CA_PATH=./certs/global-bundle.pem

PORT=3001

# JWT secrets - generate strong random values per environment, never commit real values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated browser origins. In non-production, private LAN IPs are also allowed.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Admin seed (dev only)
ADMIN_SEED_PHONE=+919999999999
ADMIN_SEED_PASSWORD=Admin@123

# AWS S3 for property images
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Public base URL for stored image links. Must include https:// and a real S3 hostname.
# Example: https://your-bucket.s3.us-east-1.amazonaws.com
# Do not use an Access Point alias (...-s3alias) — it is not a browser URL.
S3_PUBLIC_BASE_URL=https://your-bucket.s3.us-east-1.amazonaws.com
