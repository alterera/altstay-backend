# AWS RDS PostgreSQL connection string.
# Prisma v7 uses the `pg` driver; SSL is configured in code via backend/certs/global-bundle.pem.
DATABASE_URL="postgresql://alterstayuser:<DB_PASSWORD>@alterstaydb.cqx8agsuaku7.us-east-1.rds.amazonaws.com:5432/postgres?schema=public&sslmode=require"
# Optional override for the RDS CA bundle path (defaults to backend/certs/global-bundle.pem)
# DATABASE_SSL_CA_PATH=./certs/global-bundle.pem

PORT=3001

# JWT secrets - generate strong random values per environment, never commit real values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated browser origins. In non-production, private LAN IPs are also allowed.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Admin seed (dev only)
ADMIN_SEED_PHONE=+919999999999
ADMIN_SEED_PASSWORD=Admin@123

# Bookings: how long a PAYMENT_PENDING reservation holds its inventory before the
# maintenance job expires it and releases the rooms. Defaults to 45. Must exceed
# Cashfree's 15-minute minimum order_expiry_time (see PAYMENT_SESSION_MIN_HOLD_*).
BOOKING_HOLD_TTL_MINUTES=45

# Checkout quote snapshot TTL (no inventory lock until Pay).
BOOKING_QUOTE_TTL_MINUTES=15

# --- Payments (Phase B) -----------------------------------------------------
# pay.alterera.net. Leave PAYMENT_SERVICE_BASE_URL empty to disable online payment;
# booking creation keeps working, only the payment-session endpoint returns 503.
PAYMENT_SERVICE_BASE_URL=https://pay.alterera.net
# Bearer token we send to the payment service. Outbound only, never sent to a browser.
PAYMENT_SERVICE_TOKEN=
PAYMENT_SERVICE_TIMEOUT_MS=10000

# Shared HMAC secret used to verify payment confirmations arriving at
# POST /internal/payments/notifications. Must match the payment service's
# HOTEL_NOTIFICATION_SIGNING_SECRET exactly.
PAYMENT_NOTIFICATION_SIGNING_SECRET=
PAYMENT_NOTIFICATION_MAX_SKEW_SECONDS=300

# Refuse to open checkout when the inventory hold has less than this long left.
# Defaults to 16 minutes so Cashfree accepts order_expiry_time (>15 min required).
PAYMENT_SESSION_MIN_HOLD_REMAINING_SECONDS=960
# After this long an untouched PENDING attempt is abandoned so a retry can start fresh.
PAYMENT_ATTEMPT_STALE_MINUTES=15

# Where Cashfree returns the customer. The booking reference is appended as ?ref=.
BOOKING_RESULT_URL=http://localhost:3000/bookings/result

# Booking e2e tests need a real PostgreSQL (they assert on SELECT ... FOR UPDATE).
# When set, it replaces DATABASE_URL for `npm run test:e2e`. Without it the tests
# run against DATABASE_URL and clean up their own fixtures.
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/alterstays_test?schema=public&sslmode=disable"

# AWS S3 for property images
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Public base URL for stored image links. Must include https:// and a real S3 hostname.
# Example: https://your-bucket.s3.us-east-1.amazonaws.com
# Do not use an Access Point alias (...-s3alias) — it is not a browser URL.
S3_PUBLIC_BASE_URL=https://your-bucket.s3.us-east-1.amazonaws.com
# Set to true only if the bucket is private and every image must be presigned.
# S3_SIGN_DISPLAY_URLS=true

# --- WhatsApp OTP (wa.alterera.net) -----------------------------------------
WHATSAPP_OTP_API_URL=https://wa.alterera.net/send-message
WHATSAPP_OTP_API_KEY=
WHATSAPP_OTP_SENDER=
